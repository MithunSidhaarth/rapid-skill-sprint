+  if (!fsGeom) {
+    fsGeom = new THREE.BufferGeometry();
+    fsGeom.setAttribute('position', new THREE.Float32BufferAttribute([-1, -1, 0, 3, -1, 0, -1, 3, 0], 3));
+  }
+  return fsGeom;
