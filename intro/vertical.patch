+const VERT = typeof location !== 'undefined' && new URLSearchParams(location.search).has('vertical');
+export const W = VERT ? 1080 : 1920;
+export const H = VERT ? 1920 : 1080;
+/** Physical (output) size: the logical canvas times SCALE (`?scale=2` → 3840x2160). */
+export const PW = W * SCALE;
+export const PH = H * SCALE;
